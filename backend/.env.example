# Application
PROJECT_NAME="Policy & Knowledge Assistant"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
API_V1_STR="/api/v1"

# Security & JWT
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY="insecure-dev-secret-key-change-in-production-min32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_dev_password"
POSTGRES_DB="policy_rag"
# Async URL for FastAPI SQLAlchemy async sessions
DATABASE_URL="postgresql+asyncpg://postgres:postgres_dev_password@localhost:5432/policy_rag"
# Sync URL for Alembic migrations and synchronous CLI scripts
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres_dev_password@localhost:5432/policy_rag"

# Redis Queue & Caching
REDIS_URL="redis://localhost:6379/0"
REDIS_INGESTION_QUEUE="policy_rag_ingestion_queue"

# Document Ingestion & Storage
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_BYTES=15728640
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_QUESTION_LENGTH=1000
TOP_K_RETRIEVAL=5
MIN_SIMILARITY_THRESHOLD=0.5

# AI / Provider Configurations (mock | openai | gemini)
EMBEDDING_PROVIDER="mock"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536

LLM_PROVIDER="mock"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# Initial Admin Seeding (Used by CLI seed command)
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="Admin@ChangeMe123!"
INITIAL_ADMIN_FULL_NAME="System Administrator"
